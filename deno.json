{
  "name": "@raptor/error",
  "version": "0.16.0",
  "exports": "./mod.ts",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window"
    ]
  },
  "publish": {
    "exclude": [
      ".github",
      "examples",
      "docs",
      "**/*.test.ts"
    ]
  },
  "tasks": {
    "test": "APP_URL=http://localhost:8000 deno test --coverage=coverage-report --allow-all --parallel",
    "test-coverage": "APP_URL=http://localhost:8000 deno coverage coverage-report"
  },
  "fmt": {
    "exclude": [
      "README.md"
    ]
  },
  "lock": true,
  "imports": {
    "@raptor/kernel": "jsr:@raptor/kernel@^0.25.1",
    "@raptor/types": "jsr:@raptor/types@^0.2.0",
    "shiki": "npm:shiki@^4.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.17"
  }
}
